---
import Base from '../../layouts/Base.astro';
import NombreJugador from '../../components/NombreJugador.astro';
import { partidos, jugado, resultado, fecha, horaPartido, etiquetaPartido, nombreClub, textoIncomparecencia, esApoyo, hayAsistencias } from '../../lib/stats';

export function getStaticPaths() {
  return partidos.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const r = resultado(p);
const titulo = `${p.local ? nombreClub : p.rival} vs ${p.local ? p.rival : nombreClub}`;
const titulares = p.apariciones.filter((a) => !esApoyo(p.temporada, a.jugador));
const apoyo = p.apariciones.filter((a) => esApoyo(p.temporada, a.jugador));
const ordenadas = [...titulares, ...apoyo];
const propiaRival = p.propiaRival ?? 0;
const enPropia = p.apariciones.filter((a) => (a.propia ?? 0) > 0);
const goleadores = p.apariciones.filter((a) => (a.goles ?? 0) > 0).sort((a, b) => b.goles! - a.goles!);
---
<Base titulo={titulo}>
  <h1>{titulo}</h1>
  <p>
    <span class={`res ${r ?? 'P'}`}>{r ?? '–'}</span>
    {jugado(p)
      ? <strong> Resultado: {p.golesFavor}–{p.golesContra}</strong>
      : <strong> Pendiente de jugar</strong>}
    <span class="suave"> · {fecha(p.fecha)}{horaPartido(p) && ` · ${horaPartido(p)}`} · {etiquetaPartido(p)} · {p.local ? 'En casa' : 'Fuera'}</span>
  </p>
  {p.nota && <p class="suave">{p.nota}</p>}
  {p.incomparecencia && (
    <p><strong>{textoIncomparecencia(p.incomparecencia)}.</strong> <span class="suave">El resultado se da por reglamento: no hay alineación ni goleadores.</span></p>
  )}

  {p.cronica && (<><h2>Crónica</h2><p>{p.cronica}</p></>)}

  {jugado(p) && !p.incomparecencia && (
    <>
      <h2>Goleadores</h2>
      {goleadores.length > 0 || propiaRival > 0 ? (
        <ul class="lista-goles">
          {goleadores.map((a) => (
            <li><NombreJugador id={a.jugador} /> {'⚽'.repeat(a.goles!)}</li>
          ))}
          {propiaRival > 0 && <li>En propia (del rival) {'⚽'.repeat(propiaRival)}</li>}
        </ul>
      ) : p.golesFavor === 0 ? (
        <p class="suave">No hubo goleadores.</p>
      ) : (
        <p class="suave">Goleadores sin registrar.</p>
      )}
      {enPropia.length > 0 && (
        <p class="suave">
          En propia puerta (gol para el rival): {enPropia.map((a, i) => (
            <>{i > 0 && ', '}<NombreJugador id={a.jugador} />{a.propia! > 1 && ` (${a.propia})`}</>
          ))}
        </p>
      )}
    </>
  )}

  {p.apariciones.length > 0 && (
    <>
      <h2>Alineación y estadísticas</h2>
      <div class="tabla-wrap">
        <table>
          <thead><tr><th>Jugador</th><th class="num">G</th><th class="num">A</th><th class="num">🟨</th><th class="num">🟥</th><th>MVP</th></tr></thead>
          <tbody>
            {ordenadas.map((a, i) => (
              <>
                {apoyo.length > 0 && i === titulares.length && (
                  <tr class="seccion"><td colspan="6">Jugadores de apoyo</td></tr>
                )}
                <tr>
                  <td><NombreJugador id={a.jugador} /></td>
                  <td class="num">{a.goles ?? 0}</td><td class="num">{hayAsistencias(p) ? (a.asistencias ?? 0) : '–'}</td>
                  <td class="num">{a.amarillas ?? 0}</td><td class="num">{a.rojas ?? 0}</td>
                  <td>{a.mvp ? '⭐' : ''}</td>
                </tr>
              </>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}
</Base>

<style>
  ul.lista-goles { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.2rem; }
  tr.seccion td { background: var(--linea); color: var(--suave); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
</style>
