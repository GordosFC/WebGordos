---
import { url, nombreClub } from '../lib/stats';
interface Props { titulo?: string }
const { titulo } = Astro.props;
const nav = [
  ['Inicio', '/'],
  ['Noticias', '/noticias/'],
  ['Premios', '/premios/'],
  ['Temporadas', '/temporadas/'],
  ['Plantilla', '/jugadores/'],
  ['Clasificaciones', '/clasificaciones/'],
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={url('/favicon.png')} />
    <title>Web oficial de Gordos FC</title>
  </head>
  <body>
    <header class="cabecera">
      <a class="marca" href={url('/')}>
        <img src={url('/escudoGordos.png')} alt="" width="50" height="50" />
        Gordos FC
      </a>
      <nav>
        {nav.map(([texto, ruta]) => <a href={url(ruta)}>{texto}</a>)}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="pie">#vamosgordos</footer>
  </body>
</html>

<style is:global>
  :root {
    --fondo: #fdf5c5;          /* fondo de la página */
    --superficie: #f2f1ea;     /* tarjetas y tablas */
    --texto: #17211b;
    --suave: #5d6b62;          /* texto secundario */
    --linea: #d5ddd6;          /* bordes */
    --cesped: #211e12;         /* cabecera y banner de próximo partido */
    --enlaces: #867108;        /* enlaces */
    --victoria: #49e913;        /* victorias */
    --destacado: #f1c40f;       /* acentos (gala, foco al navegar) */
    --cesped-claro: #3e3307;        /* fichaje en inicio */
    --derrota: #d43939;           /* derrotas */
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --fondo: #16160f;
      --superficie: #191816;
      --texto: #f0efea; 
      --suave: #a3a293;
      --linea: #37362a;
      --cesped: #252418;
      --enlaces: #f1f123;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--fondo);
    color: var(--texto);
    font-family: 'Avenir Next', 'Segoe UI', system-ui, sans-serif;
    line-height: 1.55;
  }
  main { max-width: 56rem; margin: 0 auto; padding: 1.5rem 1rem 4rem; }
  a { color: var(--enlaces); }
  h1 { font-size: clamp(2rem, 6vw, 3rem); line-height: 1.05; margin: 0 0 1rem; letter-spacing: -0.02em; }
  h2 { font-size: 1.35rem; margin: 2.5rem 0 0.75rem; }
  p { max-width: 65ch; }
  .suave { color: var(--suave); }

  .cabecera {
    background: var(--cesped); color: #fff;
    display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; align-items: center;
    padding: 0.75rem 1rem;
  }
  .cabecera a { color: #fff; text-decoration: none; }
  .cabecera .marca { font-weight: 800; font-size: 1.15rem; margin-right: auto; }
  .cabecera nav { display: flex; flex-wrap: wrap; gap: 1rem; }
  .cabecera nav a { opacity: 0.85; }
  .cabecera nav a:hover { opacity: 1; text-decoration: underline; }
  a:focus-visible { outline: 3px solid var(--destacado); outline-offset: 2px; }
  .pie { text-align: center; color: var(--suave); padding: 2rem 1rem; font-size: 0.9rem; }

  .tabla-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; background: var(--superficie); border: 1px solid var(--linea); }
  th, td { padding: 0.55rem 0.75rem; text-align: left; border-bottom: 1px solid var(--linea); white-space: nowrap; }
  th { font-size: 0.85rem; color: var(--suave); font-weight: 600; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  tr:last-child td { border-bottom: 0; }

  .res { display: inline-grid; place-items: center; width: 1.7rem; height: 1.7rem; border-radius: 50%; font-weight: 800; font-size: 0.8rem; color: #fff; }
  .res.V { background: var(--victoria); }
  .res.E { background: var(--suave); }
  .res.D { background: var(--derrota); }
  .res.P { background: transparent; color: var(--suave); border: 1px dashed var(--suave); }

  .cifras { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1rem 0; }
  .cifra { background: var(--superficie); border: 1px solid var(--linea); padding: 0.6rem 1rem; min-width: 5.5rem; }
  .cifra strong { display: block; font-size: 1.7rem; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .cifra span { color: var(--suave); font-size: 0.85rem; }
</style>
