---
import Base from '../layouts/Base.astro';
import Partido from '../components/Partido.astro';
import Carrusel from '../components/Carrusel.astro';
import NombreJugador from '../components/NombreJugador.astro';
import { partidos, balance, ranking, ultimosPartidos, proximoPartido, temporadaActual, fecha, url, nombreClub, etiquetaPartido, noticias, galaAbierta, nombreTemporada } from '../lib/stats';

const b = balance(partidos);
const proximo = proximoPartido();
const actual = temporadaActual();
const gala = galaAbierta();
const goleadores = ranking('goles', partidos, 3);
---
<Base>
  <h1>{nombreClub}</h1>
  <p class="suave">Resultados, plantillas y estadísticas de todas las temporadas.</p>

  {proximo ? (
    <section class="proximo">
      <p>Próximo partido</p>
      <h2>{proximo.local ? 'Nosotros' : proximo.rival} vs {proximo.local ? proximo.rival : 'Nosotros'}</h2>
      <p>{fecha(proximo.fecha)} · {etiquetaPartido(proximo)}</p>
    </section>
  ) : (
    <section class="proximo">
      <p>Próximo partido</p>
      <h2>Por definir</h2>
      <p>{actual ? `${actual.nombre}${actual.splitActual ? ` · Split ${actual.splitActual}` : ''} · ` : ''}Calendario por definir</p>
    </section>
  )}

  {gala && (
    <a class="gala" href={url('/premios/')}>
      Gala {nombreTemporada(gala.temporada)}: votaciones abiertas. Mira los nominados.
    </a>
  )}

  <h2>Noticias destacadas</h2>
  <Carrusel />
  <p><a href={url('/noticias/')}>Ver todas las noticias</a></p>

  <h2>Balance histórico</h2>
  <div class="cifras">
    <div class="cifra"><strong>{b.pj}</strong><span>Jugados</span></div>
    <div class="cifra"><strong>{b.v}</strong><span>Victorias</span></div>
    <div class="cifra"><strong>{b.e}</strong><span>Empates</span></div>
    <div class="cifra"><strong>{b.d}</strong><span>Derrotas</span></div>
    <div class="cifra"><strong>{b.gf}</strong><span>Goles a favor</span></div>
    <div class="cifra"><strong>{b.gc}</strong><span>Goles en contra</span></div>
  </div>

  <h2>Últimos resultados</h2>
  <div>{ultimosPartidos(5).map((p) => <Partido p={p} />)}</div>

  <h2>Máximos goleadores</h2>
  <ol>
    {goleadores.map(({ jugador, valor }) => (
      <li><NombreJugador id={jugador.id} /> — {valor} goles</li>
    ))}
  </ol>
</Base>

<style>
  .gala { display: block; background: var(--destacado); color: #17211b; padding: 0.8rem 1.1rem; font-weight: 600; text-decoration: none; margin-bottom: 1rem; }
  .proximo { background: var(--cesped); color: #fff; padding: 1.2rem 1.4rem; margin: 1.5rem 0; }
  .proximo h2 { margin: 0.2rem 0 0.4rem; font-size: 1.8rem; }
  .proximo p { margin: 0; color: #dfe9e2; }
</style>
