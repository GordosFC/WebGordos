---
import Base from '../../layouts/Base.astro';
import NotaRegistro from '../../components/NotaRegistro.astro';
import { jugadores, temporadas, partidos, hayAsistencias, partidosDe, statsJugador, rolDe, esApoyo, golesPorPartido, url } from '../../lib/stats';

export function getStaticPaths() {
  return jugadores.map((j) => ({ params: { id: j.id }, props: { j } }));
}
const { j } = Astro.props;
const total = statsJugador(j.id);
const rol = rolDe(j.id);
const porTemporada = temporadas
  .filter((t) => t.plantilla.includes(j.id) || esApoyo(t.id, j.id))
  .map((t) => ({ t, s: statsJugador(j.id, partidosDe(t.id)), lista: partidosDe(t.id) }));
const soloApoyo = porTemporada.length > 0 && porTemporada.every(({ t }) => esApoyo(t.id, j.id));
// Foto: public/jugadores/<id>.jpg (o el nombre que pongas en el campo "foto" de jugadores.json). Sin foto salen sus iniciales.
const foto = (j as typeof j & { foto?: string }).foto ?? `${j.id}.jpg`;
const palabras = j.nombre.split(' ');
const iniciales = (palabras[0][0] + (palabras.length > 1 ? palabras[palabras.length - 1][0] : '')).toUpperCase();
---
<Base titulo={j.nombre}>
  <div class="cabecera-ficha">
  <div class="datos">
  <h1>{j.nombre}</h1>
  <p class="suave">#{j.dorsal} · {j.posicion}{j.apodo ? ` · «${j.apodo}»` : ''}{rol === 'capitan' ? ' · Capitán' : rol === 'subcapitan' ? ' · Subcapitán' : ''}{soloApoyo ? ' · Jugador de apoyo' : ''}</p>

  <div class="cifras">
    <div class="cifra"><strong>{total.pj}</strong><span>Partidos</span></div>
    <div class="cifra"><strong>{total.goles}</strong><span>Goles</span></div>
    <div class="cifra"><strong>{golesPorPartido(total)}</strong><span>Goles/partido</span></div>
    <div class="cifra"><strong>{partidos.some(hayAsistencias) ? total.asistencias : '–'}</strong><span>Asistencias</span></div>
    <div class="cifra"><strong>{total.mvp}</strong><span>MVP</span></div>
    {total.propias > 0 && <div class="cifra"><strong>{total.propias}</strong><span>En propia</span></div>}
    <div class="cifra"><strong>{total.amarillas}/{total.rojas}</strong><span>Amarillas/Rojas</span></div>
  </div>
  </div>

  <div class="foto">
    <span class="monograma">{iniciales}</span>
    <img src={url(`/jugadores/${foto}`)} alt={j.nombre} onerror="this.style.display='none'" />
  </div>
  </div>

  <h2>Por temporada</h2>
  <div class="tabla-wrap">
    <table>
      <thead><tr><th>Temporada</th><th class="num">PJ</th><th class="num">G</th><th class="num">G/P</th><th class="num">A</th><th class="num">MVP</th></tr></thead>
      <tbody>
        {porTemporada.map(({ t, s, lista }) => (
          <tr>
            <td><a href={url(`/temporadas/${t.id}/`)}>{t.nombre}</a>{esApoyo(t.id, j.id) && <span class="suave"> (apoyo)</span>}</td>
            <td class="num">{s.pj}</td><td class="num">{s.goles}</td><td class="num">{golesPorPartido(s)}</td>
            <td class="num">{lista.some(hayAsistencias) ? s.asistencias : '–'}</td><td class="num">{s.mvp}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <NotaRegistro />
</Base>

<style>
  .cabecera-ficha { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1.5rem; align-items: start; }
  .foto {
    position: relative; width: 9.5rem; aspect-ratio: 3 / 4; display: grid; place-items: center; overflow: hidden;
    border: 0.2rem solid var(--destacado); background: linear-gradient(160deg, #3d3409, #15130a);
    box-shadow: 0 0 0 0.25rem rgba(241, 196, 15, 0.15);
  }
  .foto img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 20%; }
  .monograma { font-size: 2.6rem; font-weight: 800; color: var(--destacado); }

  /* cifras algo más compactas para que quepan junto a la foto */
  .datos :global(.cifras) { gap: 0.5rem; }
  .datos :global(.cifra) { padding: 0.5rem 0.75rem; min-width: 0; }

  @media (max-width: 40rem) { /* en el móvil la foto va arriba */
    .cabecera-ficha { grid-template-columns: 1fr; }
    .foto { order: -1; width: 7.5rem; }
  }
</style>
