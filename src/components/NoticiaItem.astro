---
import { type Noticia, etiquetaTipo, fecha, url } from '../lib/stats';
interface Props { n: Noticia }
const { n } = Astro.props;
---
<a class="noticia" href={url(`/noticias/${n.id}/`)}>
  <span class={`tipo ${n.tipo}`}>{etiquetaTipo[n.tipo]}</span>
  <span class="cuerpo">
    <strong>{n.titulo}</strong>
    <span>{n.resumen}</span>
    <small>{fecha(n.fecha)}</small>
  </span>
</a>

<style>
  .noticia {
    display: flex; gap: 0.9rem; align-items: flex-start;
    padding: 0.8rem 0.9rem; background: var(--superficie); border: 1px solid var(--linea);
    color: inherit; text-decoration: none; margin-bottom: -1px;
  }
  .noticia:hover { background: color-mix(in srgb, var(--superficie) 90%, var(--cesped-claro)); }
  .cuerpo { display: flex; flex-direction: column; gap: 0.1rem; }
  small { color: var(--suave); }
  .tipo { font-size: 0.8rem; font-weight: 700; padding: 0.15rem 0.5rem; background: var(--linea); color: var(--texto); flex-shrink: 0; }
  .tipo.fichaje { background: var(--fichaje); color: #fff; }
  .tipo.premio { background: var(--destacado); color: #17211b; }
</style>
